# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
APP_SECRET=change-me-to-a-long-random-string
# Optional, enables two-factor sign-in (64 hex characters)
TWO_FACTOR_ENCRYPTION_KEY=

# Public URL of the Umami API container, as your visitors' browsers reach it
# (tracker script, /api/send, short links and pixels). Example: https://api.stats.example.com
UMAMI_PUBLIC_URL=http://localhost:3000

# Time zone used to group chart data by day/hour
TIMEZONE=Europe/Berlin

# App name until you set one under Admin → Branding
BRAND_NAME=Halftone

API_PORT=3000
DASHBOARD_PORT=3100
